---
import Layout from "@/layouts/Layout.astro";
import { FileUserIcon, FolderCodeIcon, ContactIcon } from "lucide-react";
import Experience from "@/components/Experience.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Projects from "@/components/Projects.astro";
import Hero from "@/components/Hero.astro";
import Contact from "@/components/Contact.astro";
import { getI18N } from "@/i18n/utils";
const { currentLocale } = Astro;
const t = getI18N({ currentLocale });
---

<Layout title={t.metadata.title} description={t.metadata.description}>
  <main class="px-4">
    <SectionContainer id="top" class="pt-16 md:pt-30 gap-x-4 flex items-center -mb-14 md:mb-0">
      <Hero />
    </SectionContainer>

    <SectionContainer id="experience" class="pt-18">
      <h2
        class="text-2xl md:text-3xl font-bold mb-5 flex gap-x-2 items-center"
      >
        <FileUserIcon className="size-10 md:size-14" />
        <span class="text-secondary">{t.experience.title}</span>
      </h2>
      <Experience />
    </SectionContainer>

    <!-- <SectionContainer id="projects" class="pt-18">
      <h2
        class="text-2xl md:text-3xl font-bold mb-5 flex gap-x-2 items-center"
      >
        <FolderCodeIcon className="size-7 md:size-10" />
        <span class="text-secondary">{t.projects.title}</span>
      </h2>
      <Projects />
    </SectionContainer> -->
    <SectionContainer id="contact" class="pt-18 pb-8">
      <h2
        class="text-2xl md:text-3xl font-bold mb-5 flex gap-x-2 items-center"
      >
        <ContactIcon className="size-7 md:size-10" />
        <span
          class="bg-gradient-to-l from-primary to-secondary bg-clip-text text-transparent animate-gradient"
          style="background-size: 200% 200%;">{t.contact.title}</span
        >
      </h2>
      <Contact />
    </SectionContainer>
  </main>
</Layout>
